  m_Name: 
  m_EditorClassIdentifier: 
  introPanel: {fileID: 1826295992}
  characterImage: {fileID: 52757259}
  nameText: {fileID: 322528472}
  dialogueText: {fileID: 1739432912}
  nextButton: {fileID: 1461743641}
  dialogueLines:
  - characterName: Jammy
    dialogue: '"Yaayy, we finally finished all the jam orders!"'
    characterSprite: {fileID: 21300000, guid: 034a8db72b3b82d4c895baf36c49d578, type: 3}
  - characterName: Jammy
    dialogue: '"Making jam is really easy, rightt?"'
    characterSprite: {fileID: 21300000, guid: 034a8db72b3b82d4c895baf36c49d578, type: 3}
  - characterName: Jammy
    dialogue: '"For the next step, you can help me make another jams... Not just
      strawberry, but also blueberry and apple jam!"'
    characterSprite: {fileID: 21300000, guid: 034a8db72b3b82d4c895baf36c49d578, type: 3}
  - characterName: Jammy
    dialogue: '"I also believe you can manage it on your own :D"'
    characterSprite: {fileID: 21300000, guid: 034a8db72b3b82d4c895baf36c49d578, type: 3}
